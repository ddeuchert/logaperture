<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-sample-quarkus-extension</artifactId>

  <description>
    The Quarkus sample application built with the LogAperture extension instead of the agent, for
    QuarkusExtensionIT -- NOT part of the product (doc/specs/quarkus-extension.md). The source is
    logaperture-sample-quarkus's own, compiled from that module's directory, so the two samples
    cannot drift. Built only with the `quarkus` profile; the Quarkus version is -Dquarkus.version.
  </description>

  <properties>
    <!-- A test fixture, never published (doc/specs/maven-central-publishing.md). -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <quarkus.version>3.39.5</quarkus.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Build order only (the usual Quarkus pattern): the Quarkus build resolves the extension's
      deployment module, which nothing else depends on, so `-pl logaperture-it -am` would not build it.
    -->
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-quarkus-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/../logaperture-sample-quarkus/src/main/java</sourceDirectory>
    <resources>
      <resource>
        <directory>${project.basedir}/../logaperture-sample-quarkus/src/main/resources</directory>
      </resource>
      <!-- This sample's own: a library recipe file the extension's class-loader scan must find (#6). -->
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
