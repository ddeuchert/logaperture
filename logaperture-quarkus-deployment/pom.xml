<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-quarkus-deployment</artifactId>
  <name>LogAperture Quarkus extension - deployment</name>

  <description>
    The Quarkus extension's build-time module (doc/specs/quarkus-extension.md): registers the
    feature and records the runtime-init step that starts the engine once Quarkus has set up logging.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.extension.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-core-deployment</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The vendor-defaults parser the build step checks a bundled file with
      (doc/specs/bundled-vendor-defaults.md #3). The runtime jar has it shaded, but a build inside this
      reactor resolves the runtime module as its unshaded classes, so the build step can't rely on
      that. A normal dependency, so this reactor's own builds have it; shaded into this jar and left
      out of the published (dependency-reduced) POM, so an application's build has it from here.
      A deployment module's dependencies are only ever on the build's class path, never in the app.
    -->
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <includes>
                  <include>org.logaperture:logaperture-core</include>
                  <include>org.logaperture:logaperture-api</include>
                  <include>org.logaperture:logaperture-bridge</include>
                </includes>
              </artifactSet>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.quarkus</groupId>
              <artifactId>quarkus-extension-processor</artifactId>
              <version>${quarkus.extension.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
