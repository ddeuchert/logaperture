<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-agent</artifactId>

  <description>
    premain/agentmain entry points, classloader plumbing, framework
    detection—see doc/logaperture-spec.md §4.6. premain is the primary,
    exit-criterion-tested entry point (§2, §4.1); agentmain is present but
    secondary for this slice.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-bridge</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-adapter-logback</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-container-none</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-control-jmx</artifactId>
    </dependency>

    <!-- Test-only: the fixture app used by LevelControlEndToEndIT needs a
         real Logback on ITS classpath (a separate process from the agent). -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- com.sun.tools.attach.VirtualMachine—part of the JDK (jdk.attach
         module), needed explicitly on the compile classpath by the IT. -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>logaperture-agent</finalName>
              <!--
                Belt-and-suspenders: logback-classic/slf4j-api are test-scope
                here (never compile/runtime), so the shade plugin would
                already exclude them—this makes that exclusion explicit
                so a future scope mistake fails loudly (a duplicated Logback
                inside the agent jar) rather than silently shipping one.
              -->
              <artifactSet>
                <excludes>
                  <exclude>ch.qos.logback:*</exclude>
                  <exclude>org.slf4j:*</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>org.logaperture.agent.LogApertureAgent</Premain-Class>
                    <Agent-Class>org.logaperture.agent.LogApertureAgent</Agent-Class>
                    <!--
                      Read back at runtime via Package.getImplementationVersion()
                      and published as the -Dlogaperture.version marker
                      logaperture-cli discovers JVMs by (doc/specs/cli-transport.md).
                    -->
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Can-Redefine-Classes>false</Can-Redefine-Classes>
                    <!--
                      false: LogbackLoadDetector only observes new class
                      loads via addTransformer's 1-arg form (never calls
                      retransformClasses on an already-loaded class), so
                      retransform capability isn't needed—least privilege.
                    -->
                    <Can-Retransform-Classes>false</Can-Retransform-Classes>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <logaperture.agent.jar>${project.build.directory}/logaperture-agent.jar</logaperture.agent.jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
