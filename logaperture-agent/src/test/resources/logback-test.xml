<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Known, deterministic baseline for LevelControlEndToEndIT's fixture
       app: ROOT at INFO, nothing else explicit. -->
  <root level="INFO">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>
