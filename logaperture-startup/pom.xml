<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-startup</artifactId>

  <description>
    The start-up work every delivery route shares (doc/specs/quarkus-extension.md #10): load and
    audit the vendor defaults file, register the control surface, publish the discovery marker and
    print the startup line. The agent calls it after its readiness gate; the Quarkus extension calls
    it directly. Never depends on logaperture-agent (doc/logaperture-spec.md §4.6).
  </description>

  <properties>
    <!-- Built into the agent and extension jars, never published on its own (doc/specs/maven-central-publishing.md). -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-bridge</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-control-jmx</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>startup-must-not-depend-on-agent</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.logaperture:logaperture-agent</exclude>
                  </excludes>
                  <message>
                    logaperture-startup must never depend on logaperture-agent: the Quarkus extension
                    starts the engine through it with no agent present (doc/specs/quarkus-extension.md #11).
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
