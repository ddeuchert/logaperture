<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-dist</artifactId>
  <packaging>pom</packaging>

  <description>
    The hand-off evaluation bundle — NOT a product artifact. `mvn package`
    assembles target/logaperture-${project.version}.zip containing the agent
    jar, the logctl CLI (jar + launchers), a WildFly install doc, and the
    licence, for someone to try LogAperture in a PRE-PRODUCTION WildFly.
    See doc/specs/distribution-bundle.md.

    Depends on logaperture-agent and logaperture-cli for reactor build
    ordering only (so their shaded jars exist before this module runs); the
    assembly copies those jars in by path, not as dependencies — see
    src/assembly/dist.xml.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>logaperture-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>evaluation-bundle</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <appendAssemblyId>false</appendAssemblyId>
              <!--
                The zip is a build output to hand out, not a Maven artifact.
                attach=false keeps `mvn install` from installing it into the
                local repo alongside this module's .pom (and, on older
                assembly-plugin versions, from replacing the .pom file itself
                because appendAssemblyId is false). Maven Central / deploy is
                deferred anyway.
              -->
              <attach>false</attach>
              <descriptors>
                <descriptor>src/assembly/dist.xml</descriptor>
              </descriptors>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
