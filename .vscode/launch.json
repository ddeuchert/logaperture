{
  "version": "0.2.0",
  // No module in this repo has an application main() — logaperture-agent is
  // a javaagent (LogApertureAgent.premain/agentmain), not a standalone app.
  // JUnit tests don't need an entry here either: the Test Runner for Java
  // extension adds "Debug Test" CodeLenses above @Test methods directly.
  //
  // The two configs below cover the cases a CodeLens can't:
  "configurations": [
    {
      // Manually exercise the fixture app that LevelControlEndToEndIT
      // forks as a child process (logaperture-agent/src/test/java/...
      // it/FixtureApp.java) — a real java -jar-style SLF4J/Logback app,
      // useful to run standalone while poking at the agent by hand.
      // Add "-javaagent:<path-to-built-agent-jar>" to vmArgs to attach the
      // agent the way the IT test does.
      "type": "java",
      "name": "Launch FixtureApp",
      "request": "launch",
      "mainClass": "org.logaperture.agent.it.FixtureApp",
      "projectName": "logaperture-agent",
      "vmArgs": ""
    },
    {
      // Attach to an already-running JVM by PID — for stepping through
      // premain/instrumentation logic in a process the agent was attached
      // to outside VS Code (e.g. a forked IT test process, or a manually
      // started -javaagent run).
      "type": "java",
      "name": "Attach to process",
      "request": "attach",
      "processId": "${command:PickJavaProcess}"
    },
    {
      // Attach to the WildFly started by dev/wildfly (see
      // doc/specs/wildfly-dev-environment.md). The container publishes JDWP on
      // 8787. preLaunchTask brings the environment up first — `up -d` on an
      // already-running project is a no-op, so this is safe to run repeatedly.
      //
      // Use this for breakpoints in code the agent runs AFTER boot (the
      // verification sweep, adapter operations). For premain, use the config
      // below instead.
      "type": "java",
      "name": "Attach to WildFly (8787)",
      "request": "attach",
      "hostName": "localhost",
      "port": 8787,
      "projectName": "logaperture-agent",
      "preLaunchTask": "WildFly: up"
    },
    {
      // The premain path. Run the "WildFly: up (debug-suspend)" task FIRST —
      // the JVM boots suspended and waits for this attach before running a
      // single line, so a breakpoint in LogApertureAgent.premain /
      // AgentBootstrap.start / WildFlyContainerIntegration is guaranteed to be
      // in place before premain fires. No preLaunchTask here: the plain "up"
      // wait would never see a clean boot while the JVM is suspended.
      "type": "java",
      "name": "Attach to WildFly — premain (8787)",
      "request": "attach",
      "hostName": "localhost",
      "port": 8787,
      "projectName": "logaperture-agent"
    }
  ]
}
