<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.logaperture</groupId>
  <artifactId>logaperture-parent</artifactId>
  <version>1.0.0-beta.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>LogAperture</name>
  <description>Runtime logging control for the JVM.</description>
  <!-- Maven Central requires url, licenses, developers and scm (doc/specs/maven-central-publishing.md). -->
  <url>https://logaperture.org</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>ddeuchert</id>
      <name>David Deuchert</name>
      <url>https://github.com/ddeuchert</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/ddeuchert/logaperture.git</connection>
    <developerConnection>scm:git:git@github.com:ddeuchert/logaperture.git</developerConnection>
    <url>https://github.com/ddeuchert/logaperture</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/ddeuchert/logaperture/issues</url>
  </issueManagement>

  <!--
    Module list, in dependency order for readability. Actual build order is
    computed by Maven from the reactor's dependency graph, not this order.
    See doc/specs/level-control.md "Module scope for this slice".
  -->
  <modules>
    <module>logaperture-bridge</module>
    <module>logaperture-api</module>
    <module>logaperture-core</module>
    <module>logaperture-adapter-logback</module>
    <module>logaperture-adapter-jul</module>
    <module>logaperture-container-none</module>
    <module>logaperture-container-wildfly</module>
    <module>logaperture-control-jmx</module>
    <module>logaperture-agent</module>
    <module>logaperture-cli</module>
    <module>logaperture-it</module>
    <module>logaperture-sample-war</module>
    <module>logaperture-dist</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- The version validated by the M0 spike (doc/spikes/m0-adapter-grid.md point 1). -->
    <logback.version>1.5.13</logback.version>
    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.11.3</junit.version>

    <!--
      Compiled against for the JBoss LogManager adapter. `provided` scope: at
      runtime the adapter uses WildFly's own copy (2.1.x on WF 26.1.3, the M0
      spike target), never this one. The level-control API surface used
      (LogContext#getLogger/#getLoggerNames, Logger#getLevel/#setLevel/
      #getParent/#getHandlers) is stable across the 2.1.x-3.0.x range.
    -->
    <jboss-logmanager.version>3.0.6.Final</jboss-logmanager.version>

    <!--
      Real-WildFly integration test (logaperture-it). Gated on Docker being available.
      1.21.x bundles a docker-java new enough to negotiate with Docker Engine 25+/29+
      (older Testcontainers defaults to API 1.32, which Engine 29 refuses).
    -->
    <testcontainers.version>1.21.3</testcontainers.version>
    <wildfly.image>quay.io/wildfly/wildfly:26.1.3.Final-jdk17</wildfly.image>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
    <!-- logaperture-dist's zip is a Maven artifact only in the release profile. -->
    <logaperture.dist.attach>false</logaperture.dist.attach>
    <!-- The release profile (doc/specs/maven-central-publishing.md). -->
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Internal modules -->
      <dependency>
        <groupId>org.logaperture</groupId>
        <artifactId>logaperture-bridge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.logaperture</groupId>
        <artifactId>logaperture-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.logaperture</groupId>
        <artifactId>logaperture-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.logaperture</groupId>
        <artifactId>logaperture-adapter-logback</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.logaperture</groupId>
        <artifactId>logaperture-adapter-jul</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.logaperture</groupId>
        <artifactId>logaperture-container-none</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.logaperture</groupId>
        <artifactId>logaperture-container-wildfly</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.logaperture</groupId>
        <artifactId>logaperture-control-jmx</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Third-party -->
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jboss.logmanager</groupId>
        <artifactId>jboss-logmanager</artifactId>
        <version>${jboss-logmanager.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Every module gets JUnit 5 on the test classpath; no module needs to declare it itself. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${maven-assembly-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      JMH overhead benchmarks (doc/specs/overhead-benchmarks.md Decision #1). Kept out of the
      default reactor so a normal `mvn verify` never builds them; never deployed.
      Build: mvn -Pbench -pl logaperture-bench -am package
    -->
    <profile>
      <id>bench</id>
      <modules>
        <module>logaperture-bench</module>
      </modules>
    </profile>

    <!--
      Maven Central (doc/specs/maven-central-publishing.md). Adds sources and javadoc jars and
      signs every artifact. `deploy` goes to a staging directory, never to Central:
        mvn -Prelease -DskipTests deploy -DaltDeploymentRepository=staging::file:target/staging
      then .github/scripts/central.sh bundles, checks and uploads it. Only the modules without
      maven.deploy.skip reach the staging directory: this parent, the agent, logctl and the
      release zip. Signing reads the key and passphrase from MAVEN_GPG_KEY and
      MAVEN_GPG_PASSPHRASE.
    -->
    <profile>
      <id>release</id>
      <properties>
        <!-- logaperture-dist attaches the release zip, so it goes into the bundle. -->
        <logaperture.dist.attach>true</logaperture.dist.attach>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!-- The javadoc is internal documentation, not a published API: don't fail on its style. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!-- BouncyCastle: the key comes from MAVEN_GPG_KEY, so CI needs no gpg keyring. -->
              <signer>bc</signer>
              <bestPractices>true</bestPractices>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
