# Thin launcher for the LogAperture control CLI. Requires a JDK, not just a
# JRE (it needs com.sun.tools.attach). Build the jar with `mvn -pl
# logaperture-cli package` first.

here=$(cd "$(dirname "$0")" && pwd)
jar="$here/../target/logaperture-cli.jar"

if [ ! -f "$jar" ]; then
  echo "logctl: $jar not found — run 'mvn -pl logaperture-cli package' first." >&2
  exit 1
fi

exec java -jar "$jar" "$@"
