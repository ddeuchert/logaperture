<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-cli</artifactId>
  <!-- Maven Central requires a name in every published POM; it isn't inherited. -->
  <name>LogAperture logctl</name>

  <description>
    logctl, the attach-API and local-JMX client for the level-control
    surface (doc/logaperture-spec.md §8.1, doc/specs/cli-transport.md). A
    standalone tool, never shaded into a customer artifact; it is a client
    of a running agent, not a peer of it, so it must not depend on
    logaperture-agent (enforced below, mirroring core's own rule). It does
    carry a copy of the shaded agent jar as an opaque resource, for
    `logctl attach` to load (doc/specs/logctl-attach.md #2); no agent class
    is on the CLI's class path.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-api</artifactId>
    </dependency>
    <!--
      Brings the MXBean contract (LevelControlMXBean, LoggerInfoData,
      LevelOverrideData, JmxRegistrar.OBJECT_NAME) and, transitively,
      logaperture-core, which the CLI actively uses: CapabilityDeniedException
      and Capability live there and must be on the classpath to unwrap a
      policy denial into exit 6 (doc/specs/cli-transport.md "Capability and
      audit"). All first-party and JDK-only; no third-party dependency
      anywhere in this graph.
    -->
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-control-jmx</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!--
      Here, not in the shade plugin's own finalName: a shade finalName that differs from the
      build's leaves the thin jar as the module's artifact, and that is what Maven Central
      would get (doc/specs/maven-central-publishing.md).
    -->
    <finalName>logaperture-cli</finalName>
    <plugins>
      <!--
        The CLI is a client of a running agent, never a peer of it
        (doc/specs/cli-transport.md "Module scope"). Same build-time
        assertion pattern as logaperture-core's own "must not depend on
        agent" rule.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>cli-must-not-depend-on-agent</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.logaperture:logaperture-agent</exclude>
                  </excludes>
                  <message>
                    logaperture-cli must never depend on logaperture-agent.
                    See doc/specs/cli-transport.md "Module scope": the CLI is
                    a client of a running agent, not a peer of it.
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
          <execution>
            <id>embedded-agent-jar-built</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <files>
                    <file>${project.parent.basedir}/logaperture-agent/target/logaperture-agent.jar</file>
                  </files>
                  <message>
                    logaperture-cli embeds the shaded agent jar, which is not built. Build the agent first:
                    mvn -pl logaperture-agent,logaperture-cli -am clean package
                  </message>
                </requireFilesExist>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The agent jar `logctl attach` loads is carried inside this jar, as the resource
        agent/logaperture-agent.jar (doc/specs/logctl-attach.md #2). It is copied from the agent
        module's output by path, like logaperture-dist does, because the agent's Maven artifact is
        the thin jar, not the shaded one. This is not a dependency (banned above), so the agent
        module must build first: it precedes this one in the root <modules>, and
        `-pl logaperture-agent,logaperture-cli -am` builds both in that order. Bound to prepare-package, so a plain
        `mvn test` needs no packaged agent jar; the CLI's own tests use a fixture jar. An agent jar
        built before this run is stale if it was not built with `clean` (the shade step reuses the
        previous shaded jar).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>embed-agent-jar</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/agent</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.parent.basedir}/logaperture-agent/target</directory>
                  <includes>
                    <include>logaperture-agent.jar</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Executable single jar: java -jar target/logaperture-cli.jar ...
        First-party deps only, so no relocation is needed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Main-Class>org.logaperture.cli.Main</Main-Class>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        CliEndToEndIT launches a fixture JVM and drives the CLI against it
        cross-process. The fixture is self-contained (a fake
        LevelControlOperations behind a real MBean over a real JMX
        connection). It needs no agent jar, which is why this module can
        run the IT without a logaperture-agent dependency.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
