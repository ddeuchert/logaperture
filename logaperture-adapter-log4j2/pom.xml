<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-adapter-log4j2</artifactId>

  <description>
    Log4j 2 LoggerContext binding: level read/write. Compiled against the oldest supported
    Log4j 2 (2.20.0), never bundles it. Its classes are stored in the agent jar under
    META-INF/logaperture/log4j2/ and defined only by a BridgeClassLoader -- see
    doc/specs/log4j2-adapter.md and doc/specs/class-loader-detector.md (C2).
  </description>

  <properties>
    <!-- Built into the agent or logctl jar, never published on its own (doc/specs/maven-central-publishing.md). -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-bridge</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      provided: compiled against, never bundled. At run time the bridge class loader takes
      org.apache.logging.log4j.* from the loader that owns the application's own Log4j
      (class-loader-detector.md C3), and org.logaperture.api/core/bridge from the system loader.
    -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>${log4j2.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j2.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
