# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/
dependency-reduced-pom.xml

# --- dev/wildfly: deployed archives are local only ---
dev/wildfly/deployments/*
!dev/wildfly/deployments/.gitkeep

# Python bytecode cache (dev/wildfly/wildflyctl.py is plain stdlib scripting)
__pycache__/
*.py[cod]
