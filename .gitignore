# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/
dependency-reduced-pom.xml

# --- dev/wildfly: deployed archives are local only ---
dev/wildfly/deployments/*
!dev/wildfly/deployments/.gitkeep

# --- dev/wildfly: scratch vendor defaults files (and the staged copy in .active/) ---
dev/wildfly/vendor/*
!dev/wildfly/vendor/example-vendor-defaults.yaml

# Python bytecode cache (dev/wildfly/wildflyctl.py is plain stdlib scripting)
__pycache__/
*.py[cod]

# Personal, uncommitted notes
daves-cheatsheet.txt
.claude/skills/git-side/
DaveNotes.md

# Cross-machine handoff notes (checkpoint/resume skills) - tracked via git-side, not this repo
RESUME.md
.claude/skills/checkpoint/
.claude/skills/resume/

# Personal dev convenience wrapper - tracked via git-side, not this repo
logctl-wildfly

# git-side's own bookkeeping file (lists tracked paths) - not part of this repo
.side-tracked

# User guide build output (mkdocs build), its offline-asset cache, and a local virtualenv for it
site/
.venv-docs/
.cache/
