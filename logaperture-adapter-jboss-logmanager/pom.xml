<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-adapter-jboss-logmanager</artifactId>

  <description>
    JBoss LogManager binding: per-LogContext level read/write, the
    LogAperture-to-java.util.logging level mapping, and handler-floor
    detection. Compiled against jboss-logmanager, never bundles it — see
    doc/logaperture-spec.md §4.6 and doc/specs/wildfly-support.md Slice 2.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-bridge</artifactId>
    </dependency>

    <!--
      provided: compiled against, never bundled. Inside WildFly the agent's
      classes resolve these calls against the server's own jboss-logmanager
      (2.1.x on WF 26.1.3); this module must not ship a second copy (same
      discipline as logback-classic for the Logback adapter, §4.6). Also on
      the test classpath, which is where this module's whole test suite runs
      (a hand-built LogContext, no WildFly).
    -->
    <dependency>
      <groupId>org.jboss.logmanager</groupId>
      <artifactId>jboss-logmanager</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            Match how these classes run inside WildFly: JBoss LogManager as
            the JVM's java.util.logging.LogManager. Without this, jboss-
            logmanager's System.Logger finder prints an "accessed before the
            system property was set" warning on the first LogContext touch.
          -->
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
