<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-container-wildfly</artifactId>

  <description>
    Standalone WildFly ContainerIntegration: premain-safe detection, the
    system LogContext, the verification sweep, and a LogManager
    configuration-change hook. See doc/specs/wildfly-support.md Slice 3.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-bridge</artifactId>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-adapter-jboss-logmanager</artifactId>
    </dependency>

    <!--
      provided: compiled against, never bundled. Inside WildFly these calls
      resolve against the server's own jboss-logmanager (on the system
      classpath, since WildFly sets java.util.logging.manager to it). Also
      on this module's test classpath, where the whole suite runs against a
      hand-built LogContext (no WildFly).
    -->
    <dependency>
      <groupId>org.jboss.logmanager</groupId>
      <artifactId>jboss-logmanager</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Match how these classes run inside WildFly (see the adapter module's pom). -->
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
