# Pinned WildFly image for the dev environment.
#
# The single source of truth for the WildFly version is the <wildfly.image>
# property in the repo-root pom.xml (also consumed by logaperture-it). Keep this
# value equal to it — `wildflyctl.py up` and `status` print a non-fatal warning
# when the two disagree.
WILDFLY_IMAGE=quay.io/wildfly/wildfly:26.1.3.Final-jdk17
