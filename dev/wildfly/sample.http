# logaperture-sample-war endpoints — the dev/wildfly deploy target.
#
# Needs the "REST Client" extension (humao.rest-client): a "Send Request"
# link appears above each request below. Bring the app up first:
#
#   python3 dev/wildfly/wildflyctl.py up
#   python3 dev/wildfly/wildflyctl.py deploy
#
# The timer logs on a background thread — its output goes to the server,
# not the response body. Watch it with `python3 dev/wildfly/wildflyctl.py tail`.

@base = http://localhost:8080/logaperture-sample-war

### All defaults: "Message" at INFO via SLF4J, once each through org,
### org.logaperture and org.logaperture.log (one logger per category).
GET {{base}}/log

### Same, but DEBUG.
GET {{base}}/log?level=debug

### Same, but ERROR.
GET {{base}}/log?level=error

###
GET {{base}}/log?logger=org.logaperture.demo.Checkout.log&level=debug

###
GET {{base}}/log?logger=org.logaperture.log&level=debug

###
GET {{base}}/log?logger=dave.log&level=debug

###
GET {{base}}/log?logger=deuchert.dave.c.log&level=debug


### Same, but through java.util.logging at WARN.
GET {{base}}/log?level=warn&implementation=jul

### Custom logger name and message, through Log4j -- logs through
### org, org.logaperture, org.logaperture.demo and org.logaperture.demo.Checkout.
GET {{base}}/log?logger=org.logaperture.demo.Checkout&message=order+placed&implementation=log4j

### Unrecognized level or implementation is a 400, not a silent fallback.
GET {{base}}/log?level=verbose

### Start the background timer — a burst every 2s.
POST {{base}}/timer/start?periodMs=2000

### Start it faster (min 500ms), replacing any timer already running.
POST {{base}}/timer/start?periodMs=500&restart=true

### Timer state: running?, period, tick count.
GET {{base}}/timer/status

### Stop the timer.
POST {{base}}/timer/stop
