<!--
  The IT module has Logback on its class path (AttachPlainJvmIT runs a fixture application with it), so
  SLF4J binds to it, and with no configuration Logback logs everything at DEBUG. That includes the Docker
  client's wire logging, which writes every byte of each file Testcontainers copies into a container: the
  shaded jars, megabytes each, which filled the CI log with gigabytes and kept the build from finishing.
  INFO keeps Testcontainers' own progress lines and drops the wire dump.
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
