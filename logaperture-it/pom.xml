<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.logaperture</groupId>
    <artifactId>logaperture-parent</artifactId>
    <version>0.1.0-alpha.3-SNAPSHOT</version>
  </parent>

  <artifactId>logaperture-it</artifactId>

  <description>
    Real-server integration tests. Currently: a standalone WildFly (image
    configurable via -Dwildfly.image / -Dlogaperture.wildfly.image, default
    26.1.3.Final) booted with the agent attached, via Testcontainers. The
    whole module's tests self-skip when Docker is not available
    (@Testcontainers(disabledWithoutDocker = true)), so `mvn verify` stays
    green without Docker; CI opts in on an ubuntu runner. See
    doc/specs/wildfly-support.md Slice 3.
  </description>

  <dependencies>
    <!--
      Not used by the test code (it drives the pre-built agent + logctl jars
      by path against a real WildFly), but declared so `-pl logaperture-it -am`
      builds and installs fresh ones instead of silently reusing whatever
      already sits in target/ (issue #65).
    -->
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-agent</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.logaperture</groupId>
      <artifactId>logaperture-cli</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Compile-time only: the probe WAR's @WebListener is compiled against one
      of these, whichever matches the WildFly image under test (issue #65):
      WildFly <=26 is Jakarta EE 8 (Servlet 4.0, javax.servlet namespace);
      WildFly 27+ jumped straight to Jakarta EE 10 (Servlet 6.0, jakarta.servlet
      namespace). maven-dependency-plugin:properties (below) exposes each
      artifact's local path as ${<groupId>:<artifactId>:jar}, which the IT
      hands to the in-process compiler explicitly, so the probe compile does
      not depend on the shape of the forked JVM's java.class.path (issue #65).
    -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.0.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <!-- Sets ${javax.servlet:javax.servlet-api:jar} to the artifact's local path. -->
            <id>expose-probe-compile-deps</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!--
              The servlet-api jars the in-test probe WAR can compile against,
              one per namespace; passed explicitly so the compile does not
              rely on java.class.path. The IT picks whichever matches the
              WildFly image under test (issue #65).
            -->
            <probe.compile.classpath.javax>${javax.servlet:javax.servlet-api:jar}</probe.compile.classpath.javax>
            <probe.compile.classpath.jakarta>${jakarta.servlet:jakarta.servlet-api:jar}</probe.compile.classpath.jakarta>
            <!--
              The shaded agent jar from logaperture-agent, which the reactor
              builds before this module. finalName there is "logaperture-agent",
              so this path is stable.
            -->
            <logaperture.agent.jar>${maven.multiModuleProjectDirectory}/logaperture-agent/target/logaperture-agent.jar</logaperture.agent.jar>
            <logaperture.cli.jar>${maven.multiModuleProjectDirectory}/logaperture-cli/target/logaperture-cli.jar</logaperture.cli.jar>
            <logaperture.wildfly.image>${wildfly.image}</logaperture.wildfly.image>
            <!--
              docker-java (via Testcontainers) otherwise defaults to Docker API
              1.32, which Docker Engine 25+ rejects ("client version 1.32 is too
              old"). 1.44 is Engine 25.0 (early 2024), a reasonable floor for
              anyone running this IT; bump it if your Engine is older.
            -->
            <api.version>1.44</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
